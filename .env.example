# Copy to .env (never commit .env). Nothing here is required for the offline demo.
ASA_BOSS_USER=boss
ASA_BOSS_PASSWORD=change-me
ASA_BOSS_EMAIL=your-inbox@example.com
ASA_CLUB_EMAIL=sender@example.com
ASA_SHEET_URL=https://docs.google.com/spreadsheets/d/1hIQ5si4Ya7gvfI1CHnbQ32s7eJNiYLCB-1XAuZwPBjA/edit
# Live Sheets push (service account shared on the sheet as Editor)
ASA_SHEET_ID=1hIQ5si4Ya7gvfI1CHnbQ32s7eJNiYLCB-1XAuZwPBjA
GOOGLE_APPLICATION_CREDENTIALS=secrets/service-account.json
# Email sending, only after the Boss approves. Gmail: use an App Password.
ASA_ALLOW_SEND=no
ASA_SMTP_HOST=smtp.gmail.com
ASA_SMTP_PORT=587
ASA_SMTP_USER=
ASA_SMTP_PASSWORD=
# Optional LLM polishing of texts (OpenAI compatible)
ASA_LLM_API_KEY=
ASA_LLM_BASE_URL=https://api.openai.com/v1
ASA_LLM_MODEL=gpt-4o-mini
# Demo timeline start (first lesson week)
ASA_CLUB_START=2026-11-16
