# Copy to .env (never commit .env). Nothing here is required for the demo.
ASA_REQUIRE_LOGIN=no            # yes = dashboard asks for a login
ASA_BOSS_USER=boss
ASA_BOSS_PASSWORD=change-me
ASA_ADMIN_TOKEN=                # if set, /api/reminders, /api/invoices, /api/summary, /api/outbox, /invoice need it
ASA_CLUB_EMAIL=alexseventen@gmail.com
ASA_DEMO=no                     # yes = load the 6 synthetic demo students at start-up
# Monthly fees in EUR: PLACEHOLDERS, to be confirmed by the school
ASA_PRICE_AI=45
ASA_PRICE_ZH=40
ASA_PRICES_CONFIRMED=no         # yes removes the "to be confirmed" note
# Email sending stays OFF until the owner approves. Gmail: use an App Password.
ASA_ALLOW_SEND=no
ASA_SMTP_HOST=
ASA_SMTP_PORT=587
ASA_SMTP_USER=
ASA_SMTP_PASSWORD=
